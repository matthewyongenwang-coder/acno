# Data: never commit dataset images. They contain real people's faces and
# are licensed for research use, not redistribution. Use scripts/download_data.py.
data/*
!data/README.md
# Advice text files are plain text (no images), safe and meant to be committed
!data/guide_rules.csv
!data/acne_type_info.csv

# Training outputs: charts and sample images can contain dataset faces, so they
# stay out of git just like the datasets themselves
results/
runs/

# Trained model weights (large binaries, use releases or cloud storage if needed).
# Only the repo-root models/ folder: the browser app ships its converted ONNX
# copies in web/public/models/, which Vercel needs in git.
/models/
*.pt
*.pth
*.h5
*.onnx
*.keras
!web/public/models/*.onnx

# Secrets and credentials: never commit these
.env
.env.*
kaggle.json
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Never commit real user photos, including team selfies used for testing
test_photos/
selfies/

# Team-material holds shared exports handed round the team. The only file we
# deliberately track is the shareable notebook, whose outputs are cleared. The
# rest are raw exports: slide/doc PDFs (one is 163MB, over GitHub's 100MB file
# limit) and notebooks that still carry output images of real faces. Ignoring
# them keeps an absent-minded "git add -A" from committing either.
Team-material/*
!Team-material/Acno AI training notebook (shareable).ipynb
